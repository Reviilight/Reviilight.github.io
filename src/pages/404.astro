---
import { Image } from "astro:assets";
import Kaindii from "@/assets/media/kaindii_sad.gif";
---

<!-- FIXME: use Layout.astro -->
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>404 Not Found</title>
        <meta name="description" content="Reviilight's personal website" />
    </head>
    <body>
        <div class="center-block">
            <h1 class="error-number">404</h1>
            <h2>Not Found</h2>
            <div class="kaindii">
                <Image src={Kaindii} alt="Sad Kaindii" class="kaindii-portrait" />
                <div>&mdash;</div>
                <div>&langle;</div>
                <p class="kaindii-message">
                    Sorry, but the requested URL was not found on the server...
                    But here's some helpful links:
                </p>
            </div>

            <a href="javascript:history.back()">&gt; go back</a>
            <a href="/">&gt; go to the main page</a>
        </div>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        font-family: sans-serif;
        color: white;
    }

    body {
        background-color: black;
    }

    .error-number {
        font-size: 64px;
        margin: 0;
    }

    .center-block {
        display: flex;
        flex-direction: column;
        text-align: justify;
        align-items: center;
        justify-content: center;
        margin: 0 8px;
        height: 100%;
    }

    .kaindii {
        display: flex;
        align-items: center;
        max-width: 500px;
    }

    .kaindii-portrait {
        margin: 2px;
        width: 42px;
        height: 42px;
        image-rendering: pixelated;
    }

    .kaindii-message {
        margin: 10px;
    }
</style>
