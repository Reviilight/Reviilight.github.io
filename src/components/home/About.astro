---
import { Image } from "astro:assets";
import Contacts from "@/components/Contacts.astro";
import ModalWindow from "@/components/ui/ModalWindow.astro";
const nickname = "Reviilight";
---

<section class="center-section about-section">
    <div class="about-section__element about-section__profile">
        <img
            class="profile-picture"
            src="https://avatars.githubusercontent.com/u/55348885"
            alt="A profile picture"
        />
        <h1>{nickname}</h1>
        <b>Vadim Agababian</b>
        <p><b>Status: </b><span>unemployed</span></p>
        <ModalWindow text="open me ;3">
            <ModalWindow text="heyo 0v0">
                <ModalWindow text="heehee ^u^">
                    <span>okay, I'm tired... :&lt;</span>
                </ModalWindow>
            </ModalWindow>
        </ModalWindow>
    </div>
    <div class="about-section__element about-section__about">
        <h2>About</h2>
        <p>I'm a developer. Working on my indie game.</p>
    </div>
    <div class="about-section__element about-section__contacts">
        <h2>Contacts</h2>
        <div class="contacts-grid contacts-grid-mini">
            <Contacts itemAmount={6} showSorting="false" />
        </div>
        <ModalWindow text="Show All" title="Socials">
            <div class="contacts-grid">
                <Contacts />
            </div>
        </ModalWindow>
    </div>
</section>

<style>
    .about-section {
        display: flex;
        flex-direction: column;
    }

    .about-section__element {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px;
    }

    .about-section__profile {
    }

    .about-section__about {
        border: 1px solid rgba(255, 255, 255, 0.95);
        border-left: none;
        border-right: none;
    }

    .about-section__contacts {
    }

    .contacts-grid {
        max-width: 79vw;
        display: grid;
        gap: 8px;
        grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
        max-height: 60vh;
        overflow-y: auto;
        padding: 8px;
        border: 1px solid rgba(255, 255, 255, 0.95);
        border-radius: 16px;
    }

    .contacts-grid-mini {
        margin-bottom: 15px;
        max-width: 100%;
        grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
        max-height: none;
        overflow-y: visible;
        padding: 0px;
        border: none;
        border-radius: 0;
    }

    .profile-picture {
        border-radius: 100%;
        border: 1px solid rgba(255, 255, 255, 0.95);
        height: 128px;
        box-shadow: 0px 10px 34px -14px rgba(0, 0, 0, 0.36);
    }

    @media (min-width: 768px) {
        .about-section {
            flex-direction: row;
            align-items: normal;
        }

        .about-section__about {
            order: -1;
        }

        .about-section__profile {
            border: 1px solid rgba(255, 255, 255, 0.95);
            border-top: none;
            border-bottom: none;
        }

        .about-section__about {
            border: none;
        }
    }
</style>
