---
const { text = "...", title = "" } = Astro.props;
---

<div data-modal-window-component>
    <button data-modal-window-button>{text}</button>
    <dialog class="modal-window-wrapper" data-modal-dialog>
        <div class="modal-window" data-modal-window>
            <button class="modal-window__close-button" data-close-button>
                ×
            </button>
            <h2 class="modal-window__title">&ZeroWidthSpace;{title}</h2>
            <slot />
        </div>
    </dialog>
</div>

<script>
    document
        .querySelectorAll("[data-modal-window-component]")
        .forEach((element) => {
            const modalWindowButton = element.querySelector(
                "[data-modal-window-button]",
            );
            const modalDialog = element.querySelector(
                "[data-modal-dialog]",
            ) as HTMLDialogElement;
            const modalWindow = element.querySelector(
                "[data-modal-window]",
            ) as HTMLDialogElement;

            modalWindowButton?.addEventListener("click", () => {
                modalDialog.show();
            });

            const closeButton = element.querySelector("[data-close-button]");

            closeButton?.addEventListener("click", () => {
                modalDialog.close();
            });

            modalDialog?.addEventListener("click", (event) => {
                if (!modalWindow.contains(event.target as Node)) {
                    modalDialog.close();
                }
            });

            // Attach the dialog to the body, so that sequential dialogs
            // have the full size of the body.
            document.body.appendChild(modalDialog);
        });
</script>

<style>
    .modal-window-wrapper {
        width: 100%;
        height: 100%;
        padding: 0px;
        align-content: center;
        border: none;
        background: none;
        transition:
            opacity 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55),
            backdrop-filter 0.3s cubic-bezier(0.165, 0.84, 0.44, 1),
            background-color 0.3s cubic-bezier(0.47, 0, 0.745, 0.715),
            display 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55) allow-discrete;
        opacity: 0;
        z-index: 10;
        position: fixed;
        top: 0px;
        left: 0px;
        margin: 0%;
        backdrop-filter: blur(0px);
        background-color: rgba(0, 0, 0, 0);
    }

    .modal-window-wrapper[open] {
        opacity: 1;
        backdrop-filter: blur(8px);
        background-color: rgba(0, 0, 0, 0.1);
    }

    .modal-window-wrapper[open] .modal-window {
        transform: scale(1);
    }

    @starting-style {
        .modal-window-wrapper[open] {
            opacity: 0;
            backdrop-filter: blur(0px);
            background-color: rgba(0, 0, 0, 0);
        }
        .modal-window-wrapper[open] .modal-window {
            transform: scale(0.7);
        }
    }

    .modal-window {
        position: relative;
        margin-inline: auto;
        width: fit-content;
        /* width: 85%; */
        max-width: 900px;
        padding: 20px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.95);
        border-left: none;
        border-right: none;
        background-color: rgba(255, 255, 255, 0.95);
        box-shadow: 0px 10px 34px -14px rgba(0, 0, 0, 0.36);
        transition:
            transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55),
            opacity 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55),
            backdrop-filter 0.5s cubic-bezier(0.165, 0.84, 0.44, 1),
            background-color 0.5s cubic-bezier(0.47, 0, 0.745, 0.715),
            display 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55) allow-discrete;
        transform: scale(0.7);
    }

    .modal-window__close-button {
        font-size: 32px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        right: 10px;
        top: 10px;
        border-radius: 50%;
    }

    .modal-window__close-button:hover {
        background: linear-gradient(
            -20deg,
            rgb(245, 200, 200) 0%,
            rgb(255, 240, 240) 100%
        );
    }

    .modal-window__title {
        margin-top: 0px;
        text-align: center;
    }
</style>
